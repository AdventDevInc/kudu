{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kudu Cleaner Rules",
  "description": "Schema for Kudu cleaner rule files. Each JSON file defines cleaning targets for a specific category and platform.",
  "oneOf": [
    { "$ref": "#/definitions/SystemRules" },
    { "$ref": "#/definitions/BrowserRules" },
    { "$ref": "#/definitions/AppRules" },
    { "$ref": "#/definitions/GamingRules" },
    { "$ref": "#/definitions/GpuCacheRules" },
    { "$ref": "#/definitions/SteamRules" },
    { "$ref": "#/definitions/DatabaseRules" },
    { "$ref": "#/definitions/MiscRules" }
  ],
  "definitions": {
    "TemplatePath": {
      "type": "string",
      "description": "A file path that may contain template variables like ${HOME}, ${LOCALAPPDATA}, etc. Use forward slashes — the loader converts to OS-native separators."
    },

    "CleanTarget": {
      "type": "object",
      "required": ["path", "subcategory"],
      "additionalProperties": false,
      "properties": {
        "cacheReset": { "type": "boolean", "description": "Optional performance cache reset; unselected locally and excluded from automatic cleanup" },
        "cleanupAction": { "enum": ["uv-prune", "pnpm-prune", "windows-components", "delivery-optimization", "docker-build-prune", "journal-vacuum"] },
        "path": { "$ref": "#/definitions/TemplatePath" },
        "subcategory": { "type": "string", "minLength": 1, "description": "Display label for this target group" },
        "needsAdmin": { "type": "boolean", "description": "If true, this target requires elevated privileges" },
        "childSubdir": { "type": "string", "description": "If set, scan path/*/childSubdir instead of path directly (e.g. 'cache' for Flatpak)" },
        "deepRecencyCheck": { "type": "boolean", "description": "Inspect descendant timestamps and revalidate settled items immediately before recursive deletion" },
        "description": { "type": "string", "description": "Optional explanation of what this target cleans and why it's safe" }
      }
    },

    "SingleFileTarget": {
      "type": "object",
      "required": ["path", "subcategory"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/definitions/TemplatePath" },
        "subcategory": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },

    "AppCacheDef": {
      "type": "object",
      "required": ["id", "name", "paths"],
      "additionalProperties": false,
      "allOf": [
        { "not": { "required": ["childSubdir", "recursiveMatch"] } },
        { "not": { "required": ["childSubdir", "fileMatch"] } },
        { "not": { "required": ["recursiveMatch", "fileMatch"] } }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Unique identifier (lowercase, hyphens allowed)" },
        "name": { "type": "string", "minLength": 1, "description": "Display name" },
        "paths": {
          "type": "array",
          "items": { "$ref": "#/definitions/TemplatePath" },
          "minItems": 1
        },
        "group": { "type": "string", "minLength": 1, "description": "Optional UI section for related cleaner rules" },
        "minAgeDays": { "type": "integer", "minimum": 1, "maximum": 3650, "description": "Only clean entries at least this many days old; nested directories are checked before deletion" },
        "childSubdir": { "type": "string", "description": "If set, scan paths/*/childSubdir instead of paths directly" },
        "recursiveMatch": { "$ref": "#/definitions/RecursivePathMatch" },
        "fileMatch": { "$ref": "#/definitions/DirectFileMatch" },
        "cacheReset": { "type": "boolean", "description": "Optional performance cache reset; unselected locally and excluded from automatic cleanup" },
        "cleanupAction": { "enum": ["uv-prune", "pnpm-prune", "windows-components", "delivery-optimization", "docker-build-prune", "journal-vacuum"] },
        "description": { "type": "string" }
      }
    },

    "DirectFileMatch": {
      "type": "object",
      "required": ["names", "minAgeDays"],
      "additionalProperties": false,
      "properties": {
        "names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Exact direct file names to offer"
        },
        "childDirSuffix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$",
          "description": "Inspect only immediate child directories whose names end with this suffix"
        },
        "minAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "description": "Minimum file age in days"
        },
        "skipIfChildExists": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
          "uniqueItems": true,
          "description": "Skip the candidate directory if one of these exact direct children exists"
        }
      }
    },

    "RecursivePathMatch": {
      "type": "object",
      "required": ["anchor", "targets"],
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$",
          "description": "Exact ancestor directory name that must contain every matched target"
        },
        "anchorPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:\\*|[^/\\\\*]+)(?:/(?:\\*|[^/\\\\*]+))*$",
            "not": { "pattern": "(?:^|/)\\.\\.?(?:/|$)" }
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Relative paths to anchor roots; each segment is an exact directory name or a single * wildcard, and the final segment must equal anchor"
        },
        "targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Exact cache directory names to match beneath the anchor"
        },
        "excludedAncestors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
          "uniqueItems": true,
          "description": "Exact directory names whose subtrees must never be inspected for targets"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Maximum directory depth to inspect below each resolved anchor, or below each base path when anchorPaths is omitted (default 12)"
        }
      }
    },

    "ChromiumCacheDir": {
      "type": "object",
      "required": ["dir", "label"],
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1,
          "description": "Directory relative to the profile (or to the user-data base, for shared entries). Use forward slashes — the loader converts to OS-native separators."
        },
        "label": { "type": "string", "minLength": 1, "description": "Display label appended to the browser (and profile) name" },
        "description": { "type": "string", "description": "Optional explanation of what this directory holds and why it's safe to delete" }
      }
    },

    "ChromiumBrowser": {
      "type": "object",
      "required": ["key", "base"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "enum": ["chrome", "edge", "brave", "opera", "operaGX", "vivaldi", "arc", "chromium", "thorium", "supermium", "helium", "cromite", "catsxp"],
          "description": "Browser identifier matching the BrowserPathConfig keys"
        },
        "base": { "$ref": "#/definitions/TemplatePath" }
      }
    },

    "FirefoxForkBrowser": {
      "type": "object",
      "required": ["key", "base", "cache"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "enum": ["librewolf", "waterfox", "floorp", "zen"],
          "description": "Firefox-fork browser identifier matching the BrowserPathConfig keys"
        },
        "base": { "$ref": "#/definitions/TemplatePath" },
        "cache": { "$ref": "#/definitions/TemplatePath" }
      }
    },

    "DatabaseTarget": {
      "type": "object",
      "required": ["label", "basePath", "dbFiles"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "description": "Display label (e.g. 'Chrome', 'Firefox')" },
        "basePath": { "$ref": "#/definitions/TemplatePath" },
        "dbFiles": {
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "description": "Specific database filenames or relative paths"
            },
            {
              "type": "string",
              "pattern": "^\\$[a-zA-Z]+$",
              "description": "Reference to a sharedDbFileSets key, e.g. '$chromium'"
            }
          ]
        },
        "multiProfile": { "type": "boolean", "description": "If true, scan all profile subdirectories under basePath" },
        "profilePattern": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Glob patterns for profile subdirectories (default: 'Profile *' and 'Default')"
        },
        "description": { "type": "string" }
      }
    },

    "SystemRules": {
      "type": "object",
      "required": ["type", "cleanTargets"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "type": { "const": "system" },
        "cleanTargets": {
          "type": "array",
          "items": { "$ref": "#/definitions/CleanTarget" }
        },
        "singleFileTargets": {
          "type": "array",
          "items": { "$ref": "#/definitions/SingleFileTarget" }
        }
      }
    },

    "BrowserRules": {
      "type": "object",
      "required": ["type", "chromiumCacheDirs", "chromium", "firefox"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "type": { "const": "browsers" },
        "chromiumCacheDirs": {
          "type": "object",
          "required": ["profile"],
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "array",
              "items": { "$ref": "#/definitions/ChromiumCacheDir" },
              "minItems": 1,
              "description": "Cache directories that live inside each browser profile (Default, Profile 1, …)"
            },
            "shared": {
              "type": "array",
              "items": { "$ref": "#/definitions/ChromiumCacheDir" },
              "description": "Cache directories shared by every profile, sitting directly under the user-data base"
            }
          }
        },
        "chromium": {
          "type": "array",
          "items": { "$ref": "#/definitions/ChromiumBrowser" }
        },
        "firefox": {
          "type": "object",
          "required": ["base", "cache"],
          "additionalProperties": false,
          "properties": {
            "base": { "$ref": "#/definitions/TemplatePath" },
            "cache": { "$ref": "#/definitions/TemplatePath" }
          }
        },
        "firefoxForks": {
          "type": "array",
          "items": { "$ref": "#/definitions/FirefoxForkBrowser" }
        },
        "safari": {
          "oneOf": [
            {
              "type": "object",
              "required": ["cache"],
              "additionalProperties": false,
              "properties": {
                "cache": { "$ref": "#/definitions/TemplatePath" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },

    "AppRules": {
      "type": "object",
      "required": ["type", "apps"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "type": { "const": "apps" },
        "apps": {
          "type": "array",
          "items": { "$ref": "#/definitions/AppCacheDef" }
        }
      }
    },

    "GamingRules": {
      "type": "object",
      "required": ["type", "apps"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "type": { "const": "gaming" },
        "apps": {
          "type": "array",
          "items": { "$ref": "#/definitions/AppCacheDef" }
        }
      }
    },

    "GpuCacheRules": {
      "type": "object",
      "required": ["type", "apps"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "type": { "const": "gpu-cache" },
        "apps": {
          "type": "array",
          "items": { "$ref": "#/definitions/AppCacheDef" }
        }
      }
    },

    "SteamRules": {
      "type": "object",
      "required": ["type", "libraries", "redistPatterns"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "type": { "const": "steam" },
        "libraries": {
          "type": "array",
          "items": { "$ref": "#/definitions/TemplatePath" }
        },
        "redistPatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Known redistributable folder name patterns"
        }
      }
    },

    "DatabaseRules": {
      "type": "object",
      "required": ["type", "targets"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "type": { "const": "databases" },
        "sharedDbFileSets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "description": "Reusable sets of database filenames. Reference in targets via '$setName' in dbFiles."
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/definitions/DatabaseTarget" }
        }
      }
    },

    "MiscRules": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "type": { "const": "misc" },
        "protectedEventLogs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Event log filenames that must never be deleted"
        },
        "trashPath": {
          "oneOf": [
            { "$ref": "#/definitions/TemplatePath" },
            { "type": "null" }
          ],
          "description": "Trash/Recycle Bin path, or null if managed by OS"
        }
      }
    }
  }
}
